# Copy to .env.local for local overrides. On Vercel, set these in
# Project -> Settings -> Environment Variables (they are baked in at build time).

# There is no API URL setting: the app always calls /api on its own origin.
# Locally the Vite dev proxy forwards /api to localhost:8080; on Vercel the rewrite in vercel.json forwards it to Render.

# Public address of the site, no trailing slash. Used in Open Graph tags, robots.txt and sitemap.xml.
VITE_SITE_URL=http://localhost:5173

# Cloudflare Web Analytics token (Cloudflare dashboard -> Web Analytics). Empty = no analytics script.
VITE_CF_ANALYTICS_TOKEN=

# Set to true to show Sign in / Register / Account. Anything else hides all login UI (search works either way).
VITE_AUTH_ENABLED=true
