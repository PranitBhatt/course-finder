# Copy to .env and fill in. Never commit .env.

# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# JWT signing key (RS256), needed only when app.features.auth.enabled=true.
# Optional with the dev profile: without it a temporary key is generated at startup.
#
# 1. Create a 2048-bit RSA private key (PKCS#8 PEM, "BEGIN PRIVATE KEY"):
#      openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# 2. Base64-encode the whole file into one line (env variables don't like multi-line values):
#      openssl base64 -A -in jwt-private.pem
# 3. Paste that line below. Give the key a name; change the name whenever you change the key.
# 4. Delete jwt-private.pem (or keep it in a password manager). Never commit it.
JWT_PRIVATE_KEY=
JWT_KEY_ID=key-2026-11

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_DB=coursefinder
POSTGRES_USER=coursefinder
POSTGRES_PASSWORD=coursefinder
POSTGRES_PORT=5432
